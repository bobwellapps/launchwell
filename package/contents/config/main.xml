<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>

  <group name="General">
    <!-- Panel button -->
    <entry name="icon" type="String"><default>start-here-kde</default></entry>
    <entry name="buttonIconStyle" type="Int"><default>0</default></entry>   <!-- 0 classic colour, 1 new Plasma 6 logo, 2 custom -->
    <entry name="buttonIconMono" type="Bool"><default>false</default></entry>
    <entry name="menuLabel" type="String"><default></default></entry>

    <!-- Header -->
    <entry name="showUserHeader" type="Bool"><default>true</default></entry>
    <entry name="showAvatar" type="Bool"><default>true</default></entry>
    <entry name="showUserName" type="Bool"><default>true</default></entry>

    <!-- Behaviour -->
    <entry name="startView" type="Int"><default>0</default></entry>           <!-- 0 favourites, 1 all applications -->
    <entry name="switchOnHover" type="Bool"><default>true</default></entry>
    <entry name="alphaSort" type="Bool"><default>true</default></entry>
    <entry name="appNameFormat" type="Int"><default>0</default></entry>       <!-- 0 name, 1 generic, 2 name (generic), 3 generic (name) -->
    <entry name="showDescriptions" type="Bool"><default>true</default></entry>
    <entry name="showLetterHeaders" type="Int"><default>1</default></entry>   <!-- 0 never, 1 all apps only, 2 every list -->
    <entry name="showRecentApps" type="Bool"><default>false</default></entry>
    <entry name="showRecentDocs" type="Bool"><default>false</default></entry>
    <entry name="extendedSearch" type="Bool"><default>false</default></entry>
    <entry name="favouritesView" type="Int"><default>1</default></entry>      <!-- 0 list, 1 grid -->
    <entry name="appsView" type="Int"><default>0</default></entry>            <!-- 0 list, 1 grid -->
    <entry name="sidebarOnRight" type="Bool"><default>false</default></entry>
    <entry name="searchPosition" type="Int"><default>0</default></entry>   <!-- 0 top, 1 bottom, 2 footer by settings, 3 footer by power -->
    <entry name="searchWidth" type="Int"><default>45</default></entry>      <!-- % of menu width when in the footer -->

    <!-- Footer -->
    <entry name="showPowerBar" type="Bool"><default>true</default></entry>
    <entry name="powerButtons" type="StringList"><default>lock-screen,logout,suspend,reboot,shutdown</default></entry>
    <entry name="powerButtonText" type="Bool"><default>false</default></entry>
    <entry name="powerPosition" type="Int"><default>0</default></entry>     <!-- 0 footer right, 1 footer left, 2 footer centre, 3 top bar, 4 under categories -->
    <entry name="settingsPosition" type="Int"><default>0</default></entry>  <!-- 0 footer left, 1 footer right, 2 top bar, 3 under categories -->
    <entry name="showSettingsButton" type="Bool"><default>true</default></entry>

    <!-- Updates -->
    <entry name="checkUpdates" type="Bool"><default>true</default></entry>
    <entry name="skippedVersion" type="String"><default></default></entry>

    <!-- Internal -->
    <entry name="categoryIcons" type="StringList"><default></default></entry>
    <entry name="favouritesSeeded" type="Bool"><default>false</default></entry>
  </group>

  <group name="Appearance">
    <entry name="categoryIconStyle" type="Int"><default>0</default></entry>   <!-- 0 colour, 1 mono -->
    <entry name="appIconStyle" type="Int"><default>0</default></entry>        <!-- 0 colour, 1 mono -->
    <entry name="forceColour" type="Bool"><default>true</default></entry>
    <entry name="categoryIconSize" type="Int"><default>22</default></entry>
    <entry name="appIconSize" type="Int"><default>32</default></entry>
    <entry name="gridIconSize" type="Int"><default>48</default></entry>
    <entry name="sidebarWidth" type="Int"><default>210</default></entry>
    <entry name="rowSpacing" type="Int"><default>2</default></entry>
    <entry name="textScale" type="Int"><default>100</default></entry>
    <entry name="backgroundStyle" type="Int"><default>0</default></entry>     <!-- 0 Plasma theme, 1 solid, 2 custom colour -->
    <entry name="customBgColor" type="String"><default>#232629</default></entry>
    <entry name="customBgOpacity" type="Int"><default>92</default></entry>
    <entry name="cornerRadius" type="Int"><default>10</default></entry>
    <entry name="newAppBadge" type="Bool"><default>true</default></entry>
    <entry name="newBadgeShape" type="Int"><default>0</default></entry>       <!-- 0 dot, 1 square, 2 diamond, 3 star, 4 "New" label -->
    <entry name="newBadgeColorMode" type="Int"><default>0</default></entry>   <!-- 0 theme accent, 1 custom -->
    <entry name="newBadgeColor" type="String"><default>#27ae60</default></entry>
    <entry name="newBadgeSize" type="Int"><default>8</default></entry>
    <entry name="customBgImage" type="String"><default></default></entry>
    <entry name="bgImageFill" type="Int"><default>0</default></entry>         <!-- 0 fill/crop, 1 fit, 2 stretch, 3 tile, 4 centre -->
    <entry name="bgImageBlur" type="Int"><default>0</default></entry>         <!-- 0..64 -->
    <entry name="bgImageDim" type="Int"><default>35</default></entry>         <!-- darkening layer % -->
  </group>

  <group name="Animations">
    <entry name="openAnimation" type="Int"><default>2</default></entry>      <!-- 0 none, 1 fade, 2 slide from taskbar, 3 zoom, 4 unfold -->
    <entry name="openDuration" type="Int"><default>180</default></entry>
    <entry name="openEasing" type="Int"><default>0</default></entry>         <!-- 0 smooth, 1 gentle, 2 bouncy, 3 linear -->
    <entry name="animateClose" type="Bool"><default>true</default></entry>
    <entry name="switchAnimation" type="Int"><default>1</default></entry>    <!-- 0 none, 1 fade, 2 slide sideways, 3 slide up -->
    <entry name="switchDuration" type="Int"><default>140</default></entry>
    <entry name="cascadeItems" type="Bool"><default>false</default></entry>
    <entry name="cascadeDelay" type="Int"><default>15</default></entry>
    <entry name="smoothHover" type="Bool"><default>true</default></entry>
    <entry name="hoverDuration" type="Int"><default>100</default></entry>
    <entry name="respectPlasmaSpeed" type="Bool"><default>true</default></entry>
  </group>

  <group name="Position">
    <entry name="menuWidth" type="Int"><default>650</default></entry>
    <entry name="menuHeight" type="Int"><default>560</default></entry>
    <entry name="dragResize" type="Bool"><default>true</default></entry>
    <entry name="horizontalPosition" type="Int"><default>0</default></entry>  <!-- 0 screen centre, 1 at button, 2 left, 3 right -->
    <entry name="horizontalOffset" type="Int"><default>0</default></entry>
    <entry name="verticalPosition" type="Int"><default>0</default></entry>    <!-- 0 next to panel, 1 screen centre, 2 top of screen -->
    <entry name="verticalGap" type="Int"><default>8</default></entry>
    <entry name="verticalOffset" type="Int"><default>0</default></entry>
    <entry name="keepOnScreen" type="Bool"><default>true</default></entry>
    <entry name="windowType" type="Int"><default>0</default></entry>          <!-- 0 applet popup, 1 normal, 2 popup menu -->
  </group>
</kcfg>
